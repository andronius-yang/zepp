@@ -253,9 +253,41 @@ class TpModelWorker:
             )
 
         if self.pp_group.is_last_rank:
-            logits_output, can_run_cuda_graph = self.model_runner.forward(
-                forward_batch, pp_proxy_tensors=pp_proxy_tensors
-            )
+            from sglang.srt.layers.moe.utils import get_moe_a2a_backend
+
+            run_forward = run_forward_sample = None
+            if get_moe_a2a_backend().is_zepp():
+                # zepp: the buffer verdict of every MoE layer is read once, before the sampled ids are used; a
+                # forward that exceeded the buffers runs again after they grew (a zepp_sglang without the hooks:
+                # the stock forward). run_forward_sample may enqueue the sampling before it waits for the verdict.
+                from zepp_sglang import runtime as zepp_runtime
+
+                run_forward = getattr(zepp_runtime, "run_forward", None)
+                run_forward_sample = getattr(zepp_runtime, "run_forward_sample", None)
+            if run_forward_sample is not None and not (
+                is_verify or model_worker_batch.is_prefill_only
+            ):
+                (logits_output, can_run_cuda_graph), next_token_ids = run_forward_sample(
+                    self.model_runner,
+                    forward_batch,
+                    pp_proxy_tensors,
+                    lambda lo: self.model_runner.sample(lo, forward_batch),
+                )
+                if launch_done is not None:
+                    launch_done.set()
+                return ForwardBatchOutput(
+                    logits_output=logits_output,
+                    next_token_ids=next_token_ids,
+                    can_run_cuda_graph=can_run_cuda_graph,
+                )
+            if run_forward is not None:
+                logits_output, can_run_cuda_graph = run_forward(
+                    self.model_runner, forward_batch, pp_proxy_tensors
+                )
+            else:
+                logits_output, can_run_cuda_graph = self.model_runner.forward(
+                    forward_batch, pp_proxy_tensors=pp_proxy_tensors
+                )
             if launch_done is not None:
                 launch_done.set()
 
