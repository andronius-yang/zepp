+    ) -> torch.Tensor:
+        # zepp: the layer receives this rank's tokens only (scattered MLP mode) and owns the
+        # all-to-all; top-k ids stay LOGICAL (no expert-location dispatch), the layer maps them
+        # to its own replica placement. No all-reduce afterwards.
+        if hidden_states.shape[0] > 0:
+            router_logits, _ = self.gate(hidden_states)
+            topk_weights, topk_idx, _ = self.topk(
